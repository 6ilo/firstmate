{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/6ilo/firstmate/docs/today-contract/fm-today-receipt.v1.schema.json",
  "title": "fm-today-receipt.v1",
  "description": "Firstmate's reply to one answer, sent back through the bridge. docs/today-contract.md owns the meaning of every outcome.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "answer_id", "task_id", "outcome", "recorded_at"],
  "properties": {
    "schema": { "const": "fm-today-receipt.v1" },
    "answer_id": { "$ref": "fm-today-answer.v1.schema.json#/$defs/answer_id" },
    "task_id": { "$ref": "fm-today-card.v1.schema.json#/$defs/task_id" },
    "owner": { "$ref": "fm-today-card.v1.schema.json#/$defs/owner" },
    "outcome": { "enum": ["applied", "set-aside", "refused", "duplicate"] },
    "reason": { "type": "string", "minLength": 1, "maxLength": 400 },
    "current_card_hash": { "$ref": "fm-today-card.v1.schema.json#/$defs/sha256_hex" },
    "recorded_at": { "$ref": "fm-today-card.v1.schema.json#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "refused" } }, "required": ["outcome"] },
      "then": { "required": ["reason"] }
    },
    {
      "if": { "properties": { "outcome": { "const": "set-aside" } }, "required": ["outcome"] },
      "then": { "required": ["current_card_hash"] },
      "else": { "not": { "required": ["current_card_hash"] } }
    }
  ]
}
