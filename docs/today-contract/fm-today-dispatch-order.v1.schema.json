{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/6ilo/firstmate/docs/today-contract/fm-today-dispatch-order.v1.schema.json",
  "title": "fm-today-dispatch-order.v1",
  "description": "The order in which the captain proposes that Charted Next be dispatched. A proposal only: firstmate records it as the order of already charted work and it never starts, merges, or approves anything. docs/today-contract.md owns the meaning of every field.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "order_id", "authority", "items", "charted_as_of", "queued_at", "person", "device"],
  "properties": {
    "schema": { "const": "fm-today-dispatch-order.v1" },
    "order_id": { "type": "string", "pattern": "^dord_[A-Za-z0-9_-]{22}$" },
    "authority": { "const": "proposal" },
    "items": {
      "description": "Charted Next rows in the order proposed, first to dispatch first.",
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id"],
        "properties": {
          "task_id": { "$ref": "fm-today-card.v1.schema.json#/$defs/task_id" },
          "owner": { "$ref": "fm-today-card.v1.schema.json#/$defs/owner" }
        }
      }
    },
    "charted_as_of": { "$ref": "fm-today-card.v1.schema.json#/$defs/timestamp" },
    "queued_at": { "$ref": "fm-today-card.v1.schema.json#/$defs/timestamp" },
    "person": { "$ref": "fm-today-answer.v1.schema.json#/properties/person" },
    "device": { "$ref": "fm-today-answer.v1.schema.json#/properties/device" }
  }
}
