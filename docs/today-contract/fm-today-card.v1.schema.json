{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/6ilo/firstmate/docs/today-contract/fm-today-card.v1.schema.json",
  "title": "fm-today-card.v1",
  "description": "One captain call as the portal shows it. Firstmate composes every card; the portal renders it and never edits it. docs/today-contract.md owns the meaning of every field and the card_hash definition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "kind",
    "title",
    "question",
    "options",
    "repo",
    "text_check",
    "card_hash"
  ],
  "properties": {
    "schema": { "const": "fm-today-card.v1" },
    "task_id": { "$ref": "#/$defs/task_id" },
    "owner": { "$ref": "#/$defs/owner" },
    "kind": { "enum": ["decision", "merge", "credential", "go"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "question": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "options": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/$defs/option" },
      "contains": {
        "type": "object",
        "required": ["recommended"],
        "properties": { "recommended": { "const": true } }
      },
      "minContains": 0,
      "maxContains": 1,
      "description": "The options in the order shown: one or more, except a credential card, which carries none and is answered seen or later."
    },
    "repo": {
      "description": "owner/name of the repository the call is about, or null when the call genuinely has no repository.",
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$" }
      ]
    },
    "pr_url": {
      "type": "string",
      "maxLength": 500,
      "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]{1,5})?/[^\\s]*$"
    },
    "due": { "$ref": "#/$defs/date" },
    "head_sha": {
      "description": "On a merge card: the pull request's head commit as firstmate read it when it raised the call.",
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "subject_sha256": {
      "description": "On a go card: the SHA-256 of the plan or brief the go approves.",
      "$ref": "#/$defs/sha256_hex"
    },
    "proof": {
      "description": "On a merge or go card: the nonce firstmate minted when it raised the call, and when it will mint another.",
      "type": "object",
      "additionalProperties": false,
      "required": ["nonce", "expires_at"],
      "properties": {
        "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22,64}$" },
        "expires_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "text_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "checker", "checked_at"],
      "properties": {
        "verdict": { "enum": ["pass", "withheld"] },
        "checker": { "type": "string", "pattern": "^[a-z0-9-]{1,64}@[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "checked_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "card_hash": { "$ref": "#/$defs/sha256_hex" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "merge" } }, "required": ["kind"] },
      "then": { "required": ["pr_url"] }
    },
    {
      "if": { "properties": { "kind": { "const": "credential" } }, "required": ["kind"] },
      "then": { "properties": { "options": { "type": "array", "maxItems": 0 } } },
      "else": { "properties": { "options": { "type": "array", "minItems": 1 } } }
    },
    {
      "if": { "properties": { "kind": { "const": "merge" } }, "required": ["kind"] },
      "else": { "not": { "required": ["head_sha"] } }
    },
    {
      "if": { "properties": { "kind": { "const": "go" } }, "required": ["kind"] },
      "else": { "not": { "required": ["subject_sha256"] } }
    },
    {
      "if": { "properties": { "kind": { "enum": ["merge", "go"] } }, "required": ["kind"] },
      "else": { "not": { "required": ["proof"] } }
    }
  ],
  "$defs": {
    "task_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "owner": {
      "description": "The home that owns the call: (main) for the home the bridge runs in, otherwise the second mate's registered id. Absent means (main).",
      "type": "string",
      "pattern": "^(\\(main\\)|[A-Za-z0-9._-]{1,128})$"
    },
    "option_value": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$",
      "not": { "const": "later" }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label", "recommended"],
      "properties": {
        "value": { "$ref": "#/$defs/option_value" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "hint": { "type": "string", "minLength": 1, "maxLength": 400 },
        "recommended": { "type": "boolean" }
      }
    },
    "date": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$"
    },
    "sha256_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
